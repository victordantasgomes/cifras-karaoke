SECRET_KEY=defina-uma-chave-secreta-forte
JWT_HOURS=12
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
BLOB_READ_WRITE_TOKEN=

# Só pra rodar a suíte de testes (pytest) — precisa ser uma instância
# Postgres SEPARADA da de cima (ex.: uma branch no Neon: Console > Branches
# > Create branch). Os testes fazem TRUNCATE CASCADE nas tabelas a cada
# teste; sem essa separação, rodar a suíte apaga dados reais.
TEST_DATABASE_URL=postgresql://usuario:senha@host/banco_de_teste?sslmode=require
